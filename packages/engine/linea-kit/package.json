{
  "name": "@zeus/linea-kit",
  "version": "0.3.0",
  "description": "Canonical VOLUMES formats (DATOS.md §2/§8): JSON Schemas, curation model, validator, line loader, dramaturg segmentation tools, and viaje path manager",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "zeus-linea-kit": "bin/linea-kit.mjs"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./curation": {
      "types": "./types/curation.d.ts",
      "default": "./src/curation.mjs"
    },
    "./resolve": {
      "types": "./types/resolve.d.ts",
      "default": "./src/resolve.mjs"
    },
    "./force-activation": {
      "types": "./types/force-activation.d.ts",
      "default": "./src/force-activation.mjs"
    },
    "./validate": {
      "types": "./types/validate.d.ts",
      "default": "./src/validate.mjs"
    },
    "./loader": {
      "types": "./types/loader.d.ts",
      "default": "./src/loader.mjs"
    },
    "./tools": {
      "types": "./types/tools/index.d.ts",
      "default": "./src/tools/index.mjs"
    },
    "./starterkits": {
      "types": "./types/starterkits/index.d.ts",
      "default": "./src/starterkits/index.mjs"
    },
    "./viaje": {
      "types": "./types/viaje/index.d.ts",
      "default": "./src/viaje/index.mjs"
    },
    "./schemas/*": {
      "types": "./types/schemas/*.d.ts",
      "default": "./schemas/*"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "zeus": {
    "role": "lib"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "registry": "https://npm.scriptorium.escrivivir.co"
  },
  "files": [
    "src",
    "types",
    "schemas",
    "bin",
    "docs",
    "README.md"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "keywords": [],
  "author": ""
}
