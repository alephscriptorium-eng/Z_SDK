# GENERADO por scripts/generar-env.mjs desde presets-sdk/env — no editar a mano
# Regenerar: node scripts/generar-env.mjs · comprobar: --check
# Fuente única: packages/engine/presets-sdk/src/env/index.mjs
# Uso: copiar a .env y ajustar; el .env del operador nunca se toca.
# Clave comentada = opcional (rige el default de la fuente única).
#
# Precedencia (de mayor a menor): variable de proceso > este .env >
# default de la fuente única. Con la clave en el .env Y en el entorno
# del proceso, GANA EL PROCESO (dotenv.config() sin override).
#
# Los puertos se validan al arrancar: entero decimal 1..65535, sin
# signo, sin decimales, sin 0x, sin espacios y sin ceros a la
# izquierda. Un valor mal formado (0, -1, 65536, 3.5, 0x10, "03012")
# aborta el arranque; NO cae al default. Clave vacía = usar default.

# ── host ────────────────────────────────────────────────────────────
ZEUS_HOST=localhost                       # DEFAULT_ZEUS_HOST

# ── UI mesh (DEFAULT_ZEUS_UI_MESH · override ZEUS_PORT_*) ───────────
ZEUS_PORT_EDITOR=3012                     # editor · Editor
ZEUS_PORT_PLAYER=3013                     # player · Tablero
ZEUS_PORT_VIEW=3015                       # view · Cache
ZEUS_PORT_FIREHOSE=3016                   # firehose · Firehose
ZEUS_PORT_PLAYER_3D=3018                  # player3d · Visor 3D
ZEUS_PORT_DEBUG_3D=3019                   # debug3d · 3D Monitor
ZEUS_PORT_OPERATOR_UI=3020                # operator · Operador
# ZEUS_PORT_ARG_CONSOLE=3021              # argConsole · ARG Console
ZEUS_PORT_WEBRTC_VIEWER=3023              # webrtcViewer · WebRTC
ZEUS_PORT_OASIS_WEBRTC=3022               # oasisWebrtc · Oasis WebRTC
ZEUS_PORT_SCRIPTORIUM=3017                # scriptorium · Scriptorium
# ZEUS_PORT_POZO_VIEW=3025                # pozoView · Pozo
# ZEUS_PORT_SOLVE_VIEW=3026               # solveView · SOLVE

# ── MCP servers (DEFAULT_ZEUS_MCP · override ZEUS_MCP_*) ────────────
ZEUS_MCP_SUN=4101                         # solar.sun
ZEUS_MCP_MOON=4102                        # solar.moon
ZEUS_MCP_EARTH=4103                       # solar.earth
ZEUS_MCP_LINEA_ESPAN=4111                 # lineas.espana
ZEUS_MCP_LINEA_WP=4112                    # lineas.wpHistoria
ZEUS_MCP_FORCES=4113                      # forces.disk
ZEUS_MCP_SSB=4114                         # ssb.disk
# ZEUS_MCP_LINEA_EDITOR=4115              # lineaEditor.disk
ZEUS_MCP_FIREHOSE=3008                    # firehose.disk
# ZEUS_MCP_LAUNCHER=3050                  # launcher.disk
# ZEUS_MCP_CIUDAD_LIFECYCLE=3051          # ciudadLifecycle.disk
ZEUS_PORT_PLAYER_DEBUG=3014               # playerDebug.monitor
# ZEUS_MCP_ARG_UNO=4121                   # argPlayer.uno
# ZEUS_MCP_ARG_DOS=4122                   # argPlayer.dos
# ZEUS_MCP_POZO=4131                      # pozoPlayer.uno
# ZEUS_MCP_SOLVE=4132                     # solvePlayer.uno

# ── Spec tooling (DEFAULT_SPEC_TOOL_PORTS) ──────────────────────────
ZEUS_PORT_SPEC_STUDIO=3210                # studio
ZEUS_PORT_DOCS=3230                       # docs
ZEUS_PORT_INSPECTOR=6274                  # inspector
ZEUS_PORT_INSPECTOR_PROXY=6277            # inspectorProxy
ZEUS_INSPECTOR_TOKEN=zeus-dev-inspector   # DEFAULT_ZEUS_INSPECTOR_TOKEN

# ── MCP mutation prompts (human-in-the-loop) ────────────────────────
ZEUS_MCP_APPROVAL_TOKEN=APROBAR           # DEFAULT_MCP_APPROVAL_TOKEN

# ── no-generada (fuente: operador) ──────────────────────────────────
# Claves fuera de la fuente única presets-sdk/env: preservadas tal
# cual del .env.example anterior por el generador; jamás inventadas.

# Scriptorium runtime server (Socket.IO rooms + Admin UI) — E2
# Bridge mode: local (authority) | remote (transparent proxy to upstream)
ZEUS_SCRIPTORIUM_BRIDGE=local
# ZEUS_SCRIPTORIUM_BRIDGE_URL=https://rooms.scriptorium.escrivivir.co
# ZEUS_SCRIPTORIUM_SECRET=dev-secret
# Session transport for player-ui — room master on scriptorium /runtime (legacy /session removed)
ZEUS_SESSION_TRANSPORT=room
# Room used by the room transport. Default: scriptorium.<sessionId> (sessionId = "default").
# Set to pin every session to one fixed room (see resolveSessionRoom in @zeus/rooms).
# ZEUS_SCRIPTORIUM_ROOM=scriptorium.default

# Optional: extra MCP base URLs for catalog discovery (comma-separated)
# ZEUS_DISCOVERY_URLS=http://localhost:5001,http://localhost:5002

# Volumes (WP-U62): default = fixtures sintéticos en ./VOLUMES
# Datos vivos / ronda: ZEUS_VOLUMES_ROOT → árbol externo o volumes/ de
# @zeus/startpack-<game> (Z_SDK-games-library). No meter DISK_01 pesados aquí.
ZEUS_VOLUMES_ROOT=./VOLUMES
# ZEUS_STARTPACK_ROOT=../Z_SDK-games-library/packages/startpack-delta

# Optional: override remote Firehose sync source
# ZEUS_FIREHOSE_REMOTE_PATH=C:/path/to/WiringEditor/data/firehose

# Optional: SSB OASIS pub export (WP-U84) — JSON log dump, files-first sync
# ZEUS_SSB_LOG_PATH=C:/path/to/oasis-pub-ssb-log.json
# ZEUS_SSB_PUB_URL=https://pub.example  # provenance only; sync does not dial the pub

# Optional: Oasis blobstore live (WP-U100 probe / WP-U101 client) — unset ⇒ ⏳
# Sidecar lo entrega el equipo del pub (D-21 fila 4b); zeus solo consume HTTP.
# ZEUS_BLOB_SIDECAR_URL=https://pub.example/x/blobstore/v0
# ZEUS_BLOB_SYNC_NODE_A=@alice.ed25519   # cliente Oasis local
# ZEUS_BLOB_SYNC_NODE_B=@bob.ed25519     # pub VPS 0.8.8
# ZEUS_BLOB_HTTP_TOKEN=                  # opcional Bearer (LAN puede omitir)

# Optional: ATProto jetstream → DISK_01 (WP-U85 feed-kit)
# ZEUS_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
# ZEUS_JETSTREAM_FIXTURE=1  # offline sample posts (npm run volumes:sync:firehose -- --fixture)
# ZEUS_POZO_FEEDS=auto      # pozo authority: auto|synthetic|real

# Optional: prensa API base URL for Tablero ALEPH links
# ZEUS_PRENSA_BASE_URL=http://localhost:8080/prensa/caso

# WebRTC ICE (WP-U88 / D-17) — coturn on VPS; never Google in production
# ZEUS_WEBRTC_STUN=stun:coturn.example:3478
# ZEUS_WEBRTC_TURN_URL=turn:coturn.example:3478
# ZEUS_WEBRTC_TURN_USER=zeus
# ZEUS_WEBRTC_TURN_PASS=
# ZEUS_WEBRTC_ALLOW_GOOGLE_STUN=0
# (Only set =1 for local experiments — prints a giant WARNING; gate blocks
#  stun.l.google hardcoding outside presets-sdk/env)

# Oasis /webrtc adaptation (WP-U90) — SSB private signaling bridge
# npm run start:oasis-webrtc
# ZEUS_OPEN_BROWSER=1  # opt-in only; unset/0 = headless

# Optional: external lineas tree for re-import only
# ZEUS_LINEAS_IMPORT_SOURCE=C:/path/to/lineas-backup

# Optional: external medidor casos tree for re-import only
# ZEUS_MEDIDOR_IMPORT_SOURCE=C:/path/to/medidor-poder-politico/data/casos

# Optional: contract validation (enforce | warn | off; also 0/false and 1/true)
# ZEUS_VALIDATE=enforce
# ZEUS_HTTP_VALIDATE=enforce
# ZEUS_SOCKET_VALIDATE=enforce

# Optional: validate MCP resource payloads against Zod schemas (smoke / CI)
# ZEUS_VALIDATE_RESOURCES=1
